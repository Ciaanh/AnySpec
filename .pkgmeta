package-as: AnySpec
enable-nolib-creation: no

manual-changelog: CHANGELOG.md

# Keep in sync with make-release.ps1's $includes: ship only the TOC, the root .lua files, LICENSE,
# README.md, Locales/, UI/ and assets/logo.png.
#
# The two mechanisms are opposites -- this is a blacklist, $includes is a whitelist -- so a new
# top-level file is shipped by this one by default and dropped by that one. Everything $includes
# omits is listed here: the other assets are README screenshots. Dotfiles and dot-directories
# (.github, .gitattributes, ...) are skipped by the packager on its own.
ignore:
    - assets/configuration_frame.png
    - assets/instance_toast.jpg
    - assets/spec_selector.png
    - CHANGELOG.md
    - CLAUDE.md
    - make-release.ps1
